# Copy to .env (never commit .env). All values are optional; defaults work locally.
JOBAGENT_HOST=127.0.0.1
JOBAGENT_PORT=8000
JOBAGENT_ENVIRONMENT=development
# AI: local Ollama only - no paid API keys are used anywhere.
JOBAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
JOBAGENT_DEFAULT_MODEL=qwen3:4b
JOBAGENT_EMBEDDING_MODEL=nomic-embed-text
# Database: default is SQLite in ./data. PostgreSQL example:
# JOBAGENT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jobagent
# Browser automation: headed by default so you can solve CAPTCHAs / log in.
JOBAGENT_BROWSER_HEADLESS=false
JOBAGENT_SCHEDULER_ENABLED=true
# 0 = keep data forever
JOBAGENT_RETENTION_DAYS=0
# Optional Fernet key for encrypting stored email settings (auto-generated into data/secret.key if empty).
# JOBAGENT_SECRET_KEY=
